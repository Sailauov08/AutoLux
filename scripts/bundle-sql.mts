import { readdirSync, readFileSync, writeFileSync } from "node:fs";

const root = new URL("../supabase/", import.meta.url);
const migrations = readdirSync(new URL("migrations/", root)).filter((name) => name.endsWith(".sql")).sort();
const parts = [
  ...migrations.map((name) => `-- ===== migrations/${name}\n${readFileSync(new URL(`migrations/${name}`, root), "utf8")}`),
  `-- ===== seed.sql\n${readFileSync(new URL("seed.sql", root), "utf8")}`,
];

writeFileSync(new URL("setup.sql", root), `-- Generated by npm run db:bundle. Run once in the Supabase SQL editor on an empty project.\n\n${parts.join("\n\n")}`);
console.log(`supabase/setup.sql written (${migrations.length} migrations + seed)`);
