import { writeFileSync } from "node:fs";
import { CARS } from "../src/lib/cars.ts";
import { DEALERSHIP } from "../src/lib/site.ts";
import en from "../messages/en.json" with { type: "json" };
import ru from "../messages/ru.json" with { type: "json" };
import kk from "../messages/kk.json" with { type: "json" };

type Messages = { cars: Record<string, { description: string; features: string[] }>; dealership: Record<string, string> };
const catalogues = { en, ru, kk } as unknown as Record<"en" | "ru" | "kk", Messages>;

const sql = (value: unknown): string => {
  if (value === null || value === undefined) return "null";
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  if (Array.isArray(value) && value.every((item) => typeof item !== "object")) return `array[${value.map(sql).join(", ")}]::text[]`;
  if (typeof value === "object") return `${sql(JSON.stringify(value))}::jsonb`;
  return `'${String(value).replace(/'/g, "''")}'`;
};

const localized = (pick: (messages: Messages) => string) =>
  Object.fromEntries(Object.entries(catalogues).map(([locale, messages]) => [locale, pick(messages)]));

const dealer = "(select id from public.dealerships where slug = 'autolux')";
const INTERIOR = ["photo-1633080413628", "photo-1648786390030", "photo-1621285960899", "photo-1672717900266"];

const lines: string[] = [
  "-- Demonstration catalogue generated by scripts/generate-seed.mts.",
  "-- Idempotent: inserts only rows that do not exist yet and never updates existing data.",
  "",
  `insert into public.dealerships (slug, name, phone, email, address, maps_url, hours, socials)
select 'autolux', ${sql(DEALERSHIP.name)}, ${sql(DEALERSHIP.phone)}, ${sql(DEALERSHIP.email)},
  ${sql(Object.fromEntries(Object.entries(catalogues).map(([locale, m]) => [locale, { line1: m.dealership.address1, line2: m.dealership.address2 }])))},
  ${sql(DEALERSHIP.mapsUrl)}, ${sql(Object.fromEntries(DEALERSHIP.hours.map((slot) => [slot.key, slot.time])))}, ${sql(DEALERSHIP.socials)}
where not exists (select 1 from public.dealerships where slug = 'autolux');`,
  "",
];

for (const car of CARS) {
  const vehicle = `(select id from public.vehicles where dealership_id = ${dealer} and slug = ${sql(car.id)})`;
  lines.push(
    `insert into public.vehicles (dealership_id, slug, make, model, year, price, mileage, fuel, transmission, horsepower, drivetrain, body_type, exterior_color, engine, condition, status, published, featured, badges, description)
select ${dealer}, ${[
      car.id, car.brand, car.model, car.year, car.price, car.mileage, car.fuel, car.transmission, car.horsepower,
      car.drivetrain, car.bodyType, car.color, car.engine, car.mileage < 1000 ? "new" : "used", "available", true,
      Boolean(car.featured), car.badges, localized((m) => m.cars[car.id].description),
    ].map(sql).join(", ")}
where not exists (select 1 from public.vehicles where dealership_id = ${dealer} and slug = ${sql(car.id)});`,
  );
  car.images.forEach((url, position) => {
    lines.push(
      `insert into public.vehicle_media (dealership_id, vehicle_id, kind, source, url, credit, position)
select ${dealer}, ${vehicle}, ${sql(INTERIOR.some((id) => url.includes(id)) ? "interior" : "exterior")}, ${sql(car.photoSource === "dealer" ? "dealer" : "representative")}, ${sql(url)}, 'Unsplash', ${position}
where not exists (select 1 from public.vehicle_media where vehicle_id = ${vehicle} and position = ${position});`,
    );
  });
  catalogues.en.cars[car.id].features.forEach((_, position) => {
    lines.push(
      `insert into public.vehicle_equipment (dealership_id, vehicle_id, position, label)
select ${dealer}, ${vehicle}, ${position}, ${sql(localized((m) => m.cars[car.id].features[position]))}
where not exists (select 1 from public.vehicle_equipment where vehicle_id = ${vehicle} and position = ${position});`,
    );
  });
  lines.push("");
}

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`seed.sql written for ${CARS.length} vehicles`);
