# Supabase project → Settings → API. Use the publishable key (sb_publishable_...) or the legacy anon key.
# Never put the secret / service_role key in this app: it is not needed and would be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Slug of the dealership row this site serves (created by supabase/seed.sql as "autolux").
NEXT_PUBLIC_DEALERSHIP_SLUG=autolux

# Public origin used in auth e-mail links and staff invitation links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
